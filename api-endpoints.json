  "research_papers": {
    "list_papers": {
      "method": "GET",
      "path": "/api/trabajos/",
      "description": "Lista todos los trabajos de investigación.",
      "permissions": "AllowAny"
    },
    "create_paper": {
      "method": "POST",
      "path": "/api/trabajos/",
      "description": "Crea un nuevo trabajo de investigación (metadatos y archivo).",
      "permissions": "Admin only",
      "request_body_form_data": {
        "titulo": "string",
        "resumen": "string",
        "anio_publicacion": "integer",
        "archivo_ruta": "file (PDF)",
        "especialidad": "string",
        "fuente_fisica": "string",
        "signatura_topografica": "string",
        "autor_texto": "string",
        "asesor_texto": "string",
        "contenido": "string (empty for file upload)",
        "palabras_clave_manual": "list of strings",
        "permite_preview_publico": "boolean",
        "imagen_portada": "file (optional)"
      }
    },
    "retrieve_paper": {
      "method": "GET",
      "path": "/api/trabajos/{id}/",
      "description": "Obtiene los detalles de un trabajo de investigación específico.",
      "permissions": "AllowAny"
    },
    "update_paper": {
      "method": "PUT",
      "path": "/api/trabajos/{id}/",
      "description": "Actualiza completamente un trabajo de investigación existente.",
      "permissions": "Admin only"
    },
    "partial_update_paper": {
      "method": "PATCH",
      "path": "/api/trabajos/{id}/",
      "description": "Actualiza parcialmente un trabajo de investigación existente.",
      "permissions": "Admin only"
    },
    "delete_paper": {
      "method": "DELETE",
      "path": "/api/trabajos/{id}/",
      "description": "Elimina un trabajo de investigación.",
      "permissions": "Admin only"
    },
    "upload_paper_legacy": {
      "method": "POST",
      "path": "/api/trabajos/subir_trabajo/",
      "description": "Endpoint alternativo para subir un nuevo trabajo de investigación (legado, usa el mismo serializer que create).",
      "permissions": "Admin only",
      "request_body_form_data": "{... same as create_paper ...}"
    },
    "can_download_paper": {
      "method": "GET",
      "path": "/api/trabajos/{id}/puede_descargar/",
      "description": "Verifica si el usuario (autenticado o por token) puede descargar este trabajo. No inicia la descarga.",
      "permissions": "AllowAny",
      "query_params": {
        "token": "string (opcional, para usuarios externos)"
      },
      "response_body": {
        "puede_descargar": "boolean",
        "es_interno": "boolean",
        "creditos_disponibles": "integer (solo para usuarios internos)",
        "puede_ver_completo": "boolean (solo para usuarios externos, si tienen AccesoExterno)",
        "token": "string (echo del token enviado, si aplica)",
        "mensaje": "string (si no puede descargar)"
      }
    }
  },

  "catalog": {
    "search_catalog": {
      "method": "GET",
      "path": "/api/buscar/",
      "description": "Busqueda unificada en todo el catalogo (libros y trabajos).",
      "permissions": "AllowAny",
      "query_params": {
        "titulo": "string",
        "autor": "string",
        "anio": "integer",
        "palabra_clave": "string",
        "tipo_material": "string (libro o trabajo)"
      },
      "response_body": {
        "libros": [],
        "trabajos": [],
        "total_libros": "integer",
        "total_trabajos": "integer"
      }
    },
    "recently_added": {
      "method": "GET",
      "path": "/api/recien-agregados/",
      "description": "Devuelve materiales (libros y trabajos) agregados en los últimos 7 días.",
      "permissions": "AllowAny",
      "response_body": {
        "libros": [],
        "trabajos": [],
        "total": "integer",
        "desde": "datetime"
      }
    }
  },

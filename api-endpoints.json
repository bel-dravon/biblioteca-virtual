
{
  "authentication": {
    "login": {
      "method": "POST",
      "path": "/api/api-token-auth/",
      "description": "Obtiene un token de autenticación para un usuario. Utiliza email y password. El token debe ser enviado en los headers de futuras peticiones como 'Authorization: Token <token>'",
      "permissions": "AllowAny",
      "request_body": {
        "email": "string",
        "password": "string"
      },
      "response_body": {
        "token": "string"
      }
    }
  },
  "users": {
    "list_users": {
      "method": "GET",
      "path": "/api/users/",
      "description": "Lista todos los usuarios registrados.",
      "permissions": "Admin only"
    },
    "create_user": {
      "method": "POST",
      "path": "/api/users/",
      "description": "Crea un nuevo usuario (solo por Administrador).",
      "permissions": "Admin only",
      "request_body": {
        "email": "string",
        "password": "string",
        "first_name": "string",
        "last_name": "string",
        "is_staff": "boolean",
        "is_active": "boolean"
      }
    },
    "retrieve_user": {
      "method": "GET",
      "path": "/api/users/{id}/",
      "description": "Obtiene los detalles de un usuario específico.",
      "permissions": "Admin only"
    },
    "update_user": {
      "method": "PUT",
      "path": "/api/users/{id}/",
      "description": "Actualiza completamente un usuario existente (solo por Administrador).",
      "permissions": "Admin only"
    },
    "partial_update_user": {
      "method": "PATCH",
      "path": "/api/users/{id}/",
      "description": "Actualiza parcialmente un usuario existente (solo por Administrador).",
      "permissions": "Admin only"
    },
    "delete_user": {
      "method": "DELETE",
      "path": "/api/users/{id}/",
      "description": "Elimina un usuario (solo por Administrador).",
      "permissions": "Admin only"
    }
  },

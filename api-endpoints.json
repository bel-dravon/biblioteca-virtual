  "contributions": {
    "list_contributions": {
      "method": "GET",
      "path": "/api/aportes/",
      "description": "Lista todos los documentos de aporte.",
      "permissions": "Admin only"
    },
    "create_contribution": {
      "method": "POST",
      "path": "/api/aportes/",
      "description": "Crea un nuevo documento de aporte.",
      "permissions": "Authenticated (Usuario Interno) / AllowAny (Usuario Externo)",
      "request_body_form_data": {
        "usuario_interno": "integer (opcional, si el usuario está autenticado)",
        "nombre_completo": "string",
        "email": "string",
        "organizacion_origen": "string",
        "titulo": "string",
        "descripcion": "string",
        "archivo": "file (PDF/DOCX)",
        "estado": "string (pendiente, aceptado, rechazado - solo editable por admin)",
        "motivo_rechazo": "string (solo editable por admin)",
        "comentario_rechazo": "string (solo editable por admin)",
        "revisado_por": "integer (solo editable por admin)",
        "revisado_at": "datetime (solo editable por admin)"
      }
    },
    "retrieve_contribution": {
      "method": "GET",
      "path": "/api/aportes/{id}/",
      "description": "Obtiene los detalles de un documento de aporte específico.",
      "permissions": "Admin only (o propietario del aporte)"
    },
    "update_contribution": {
      "method": "PUT",
      "path": "/api/aportes/{id}/",
      "description": "Actualiza completamente un documento de aporte existente (solo por Administrador).",
      "permissions": "Admin only"
    },
    "partial_update_contribution": {
      "method": "PATCH",
      "path": "/api/aportes/{id}/",
      "description": "Actualiza parcialmente un documento de aporte existente (solo por Administrador).",
      "permissions": "Admin only"
    },
    "delete_contribution": {
      "method": "DELETE",
      "path": "/api/aportes/{id}/",
      "description": "Elimina un documento de aporte (solo por Administrador).",
      "permissions": "Admin only"
    }
  },

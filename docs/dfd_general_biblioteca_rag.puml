@startuml
' DFD general del flujo entre actores, vistas Django y motor RAG

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FFFDF7
  BorderColor #6B7280
  FontColor #111827
}
skinparam database {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}
skinparam actor {
  FontColor #111827
}
skinparam cloud {
  BackgroundColor #EEF6FF
  BorderColor #3B82F6
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

title DFD General - Biblioteca Virtual con Motor RAG

actor Estudiante
actor Bibliotecario

package "Capa de presentacion / API Django" {
  rectangle "P1 Consulta de catalogo\n`TrabajoInvestigacionViewSet`" as P1
  rectangle "P2 Busqueda semantica\n`RagSearchView`" as P2
  rectangle "P3 Respuesta RAG\n`RagAnswerView`" as P3
  rectangle "P4 Chat sobre PDF\n`chat_ia` en `TrabajoInvestigacionViewSet`" as P4
  rectangle "P5 Analitica y apoyo editorial\n`TrendAnalyticsView` + `validar_tema`" as P5
}

package "Motor IA / RAG" {
  rectangle "P6 Recuperacion vectorial\n`search_similar_thesis()`" as P6
  rectangle "P7 Generacion de respuesta\n`generate_rag_response()`" as P7
  rectangle "P8 Preguntas sobre PDF\n`answer_pdf_question()`" as P8
  rectangle "P9 Analisis IA\n`generate_trend_analysis()`\n`verificar_originalidad()`" as P9
  rectangle "P0 Indexacion semantica\n`embed_text()` + procesos de ingesta" as P0
}

package "Almacenes de datos" {
  database "D1 Catalogo academico\nTrabajoInvestigacion\nAutor\nAutorTrabajo\nPalabraClave\nClasificacion" as D1
  database "D2 Repositorio PDF\n`archivo_ruta` / media" as D2
  database "D3 Indice vectorial\n`ThesisEmbedding`" as D3
}

cloud "Servicio Gemini API" as Gemini

Estudiante --> P1 : filtros de consulta\ny visualizacion de trabajos
P1 --> D1 : lectura de metadatos
D1 --> P1 : trabajos, autores, palabras clave
P1 --> Estudiante : resultados del catalogo

Estudiante --> P2 : consulta semantica\nquery + filtros
P2 --> P6 : solicitud de recuperacion
P6 --> D3 : embeddings + metadata
P6 --> D1 : datos del trabajo relacionado
D3 --> P6 : vectores candidatos
D1 --> P6 : titulo, resumen, tipo, fecha
P6 --> P2 : trabajos similares
P2 --> Estudiante : resultados relevantes

Estudiante --> P3 : pregunta en lenguaje natural\nquery + filtros
P3 --> P6 : busqueda de contexto
P6 --> D3 : consulta vectorial
P6 --> D1 : enriquecimiento de contexto
P6 --> P7 : documentos recuperados
P7 --> Gemini : prompt con contexto
Gemini --> P7 : respuesta generada
P7 --> P3 : respuesta + fuentes
P3 --> Estudiante : respuesta RAG citada

Estudiante --> P4 : pregunta sobre un PDF
P4 --> D1 : validacion del trabajo
P4 --> D2 : acceso al archivo PDF
P4 --> P8 : ruta del PDF + pregunta
P8 --> D2 : extraccion de texto o archivo
P8 --> Gemini : PDF o fragmentos relevantes
Gemini --> P8 : respuesta contextual
P8 --> P4 : respuesta del documento
P4 --> Estudiante : respuesta sobre el PDF

Bibliotecario --> P1 : alta y actualizacion\nde trabajos
P1 --> D1 : guardar metadatos academicos
P1 --> D2 : guardar archivo PDF

Bibliotecario --> P5 : analitica, validacion\nde tema y supervision
P5 --> P9 : solicitud de analisis
P9 --> D1 : corpus de trabajos
P9 --> D3 : embeddings existentes
P9 --> P5 : tendencias / similitud
P5 --> Bibliotecario : apoyo a decision

D1 --> P0 : titulo, resumen, contenido
D2 --> P0 : texto fuente del PDF
P0 --> Gemini : solicitud de embeddings
Gemini --> P0 : vector semantico
P0 --> D3 : almacenamiento de embedding\ne indexed_text + metadata

note bottom of P2
  Vista autenticada que delega en
  `search_similar_thesis()` para recuperar
  tesis similares por embedding y filtros.
end note

note bottom of P3
  Encadena recuperacion + generacion:
  primero localiza contexto y luego arma
  la respuesta con citas y fuentes.
end note

note bottom of P4
  El chat documental usa `answer_pdf_question()`.
  Si el PDF es pequeno intenta carga directa;
  si no, extrae fragmentos y pregunta con contexto.
end note

note bottom of P0
  La indexacion no nace en una vista HTTP.
  En este proyecto se alimenta por procesos
  de ingesta como `import_legacy_thesis.py`.
end note

legend right
  DFD nivel general del backend.

  Actores externos:
  - Estudiante
  - Bibliotecario

  Procesos Django analizados:
  - `backend/biblioteca/views/trabajos.py`
  - `backend/ia_core/views.py`

  Servicios IA analizados:
  - `backend/ia_core/services/search_service.py`
  - `backend/ia_core/services/ml_service.py`
  - `backend/ia_core/services/gemini_client.py`
endlegend

@enduml
